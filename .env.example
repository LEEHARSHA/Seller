# Fitness Species Seller Portal Environment Setup
# Copy this file to .env.local for local development

NEXT_PUBLIC_USE_MOCK_DATA=false
# Local development URL. Set NEXT_PUBLIC_API_URL to the deployed backend in Vercel.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Firebase Web App configuration for sellerportal-2786c
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sellerportal-2786c.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sellerportal-2786c
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sellerportal-2786c.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_FIREBASE_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=REPLACE_WITH_FIREBASE_WEB_APP_ID

# Domain settings
NEXT_PUBLIC_SELLER_DOMAIN=https://seller-lilac-five.vercel.app
